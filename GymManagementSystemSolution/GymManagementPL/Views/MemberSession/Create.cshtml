@using GymManagementBLL.ViewModels.MemberSessionViewModels
@model CreateMemberSessionViewModel
@{
    ViewData["Title"] = "Create New Booking";
}

<h1>Create New Booking</h1>

<hr />
<div class="row">
    <div class="d-flex justify-content-center align-items-center h-100">

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Booking Information</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" asp-controller="MemberSession" method="post">
                        <input type="hidden" asp-for="SessionId" value="@ViewBag.SessionId" />

                        <div class="mb-3">
                            <label class="form-label">Member</label>
                            <select asp-for="MemberId"
                                    class="form-select"
                                    asp-items="ViewBag.Members">
                                <option value="">-- Select Member --</option>
                            </select>
                            <span asp-validation-for="MemberId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Create Booking
                            </button>
                            <a asp-controller="MemberSession"
                               asp-action="GetMembersForUpcomingSession"
                               asp-route-sessionId="@ViewBag.SessionId"
                               class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script>
    $(document).ready(function() {
        $('#MemberId').select2({
            placeholder: "Select a member",
            allowClear: true,
            width: '100%'
        });
    });
</script>
}


